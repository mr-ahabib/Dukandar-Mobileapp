# ---- Dukandar backend configuration ----
ENV=production
DEBUG=false

# ডাটাবেস — ডিফল্ট SQLite (WAL মোড, কোনো আলাদা সার্ভার লাগে না)। ফাইল: backend/data/dukandar.db (ফোল্ডার নিজে তৈরি হয়)।
# Default: embedded SQLite (WAL, tuned pragmas) — zero setup, very fast for a single API process.
DATABASE_URL=sqlite+aiosqlite:///./data/dukandar.db
# ঐচ্ছিক PostgreSQL (একাধিক API ইনস্ট্যান্স চালালে)। docker compose-এ host "db" (profile "postgres").
# Optional PostgreSQL (asyncpg):
# DATABASE_URL=postgresql+asyncpg://dukandar:dukandar@localhost:5432/dukandar

# অ্যাডমিন প্যানেল asset ভার্সন (?v=...) — প্যানেল আপডেট করলে বদলান যাতে ব্রাউজার ক্যাশ রিফ্রেশ হয়।
# Cache-busting version for admin panel assets; bump on each panel release.
STATIC_VERSION=2026.10.04

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_APP_ACCESS_SECRET=change-me-app-access
JWT_APP_REFRESH_SECRET=change-me-app-refresh
JWT_ADMIN_SECRET=change-me-admin

# Set to false ONLY for local http development (cookie Secure flag)
ADMIN_COOKIE_SECURE=true

# Comma separated origins; empty = CORS disabled (recommended: the app is native, panel is same-origin)
CORS_ORIGINS=

# true when behind nginx/traefik so X-Forwarded-For is trusted for rate limiting + audit IPs
TRUST_PROXY_HEADERS=true

# Daily job (Asia/Dhaka 09:00). Disable if you run `python -m app.jobs.daily` from cron instead.
SCHEDULER_ENABLED=true

# ---- প্রথমবার চালু (first-run bootstrap) ----
# AUTO_MIGRATE=true হলে সার্ভার চালু হওয়ার সময় নিজে থেকেই ডাটাবেস মাইগ্রেশন (alembic upgrade head) চালায়,
# ডিফল্ট প্ল্যান "স্ট্যান্ডার্ড" (৩০০ টাকা/৩০ দিন) ও সেটিংস তৈরি করে।
# On startup: run migrations, seed the default plan + settings row.
AUTO_MIGRATE=true
# নিচের ইমেইলে কোনো অ্যাডমিন না থাকলে প্রথমবার এই ইমেইল/পাসওয়ার্ড দিয়ে সুপার অ্যাডমিন তৈরি হবে।
# পাসওয়ার্ড: কমপক্ষে ১০ অক্ষর, একটি বড় হাতের অক্ষর ও একটি সংখ্যা। পরে .env-এ পাসওয়ার্ড বদলালে পুরনোটি বদলাবে না
# (শুধু সতর্কবার্তা লগ হবে) — বদলাতে: python scripts/create_superadmin.py
# Superadmin is created only if no admin with this email exists. Changing the password here later does NOT
# overwrite the stored one (a warning is logged); use scripts/create_superadmin.py instead.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe12345

# অ্যাডমিন প্যানেল (SPA) ফোল্ডার — backend/ এর সাপেক্ষে বা absolute path। Docker image-এ /srv/admin-panel
# Admin panel folder, relative to backend/ or absolute. In Docker it is /srv/admin-panel.
ADMIN_PANEL_DIR=../admin-panel

# Postgres container credentials (docker compose, only with:  docker compose --profile postgres up)
POSTGRES_USER=dukandar
POSTGRES_PASSWORD=dukandar
POSTGRES_DB=dukandar
